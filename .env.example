# Copy to .env for local development and replace every change-me value.
LOG_LEVEL=info
ENVOY_LOG_LEVEL=info
CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127[.]0[.]0[.]1)(:[0-9]+)?$

POSTGRES_DB=money_tracking_auth
POSTGRES_USERNAME=money_tracking
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
AUTH_DATABASE_URL=postgres://money_tracking:change-me-postgres@postgres:5432/money_tracking_auth?sslmode=disable

REDIS_PASSWORD=change-me-redis

RABBITMQ_USERNAME=money_tracking
RABBITMQ_PASSWORD=change-me-rabbitmq

JWT_KEY_ID=money-tracking-auth-dev-key
JWT_PUBLIC_KEYS=money-tracking-auth-dev-key=/run/secrets/jwt-public.pem
JWT_REFRESH_TTL=168h

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Money Tracking <no-reply@local.test>
