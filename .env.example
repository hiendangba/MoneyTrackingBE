# Copy to .env for local development and replace every change-me value.
LOG_LEVEL=info
CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127[.]0[.]0[.]1)(:[0-9]+)?$
REQUEST_TIMEOUT=10s
AUTH_SERVICE_ADDR=auth-service:50051
GROUP_SERVICE_ADDR=group-service:50052
AUTH_ACCESS_TTL=5m
AUTH_REFRESH_TTL=168h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_ADMIN_ROLE_CODE=admin
GATEWAY_CSRF_COOKIE_NAME=csrf_token

POSTGRES_DB=money_tracking_auth
POSTGRES_USERNAME=money_tracking
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
AUTH_DATABASE_URL=postgres://money_tracking:change-me-postgres@postgres:5432/money_tracking_auth?sslmode=disable

GROUP_POSTGRES_DB=money_tracking_groups
GROUP_POSTGRES_USERNAME=money_tracking_groups
GROUP_POSTGRES_PASSWORD=change-me-group-postgres
GROUP_POSTGRES_MAX_CONNS=10
GROUP_POSTGRES_MIN_CONNS=2
GROUP_DATABASE_URL=postgres://money_tracking_groups:change-me-group-postgres@group-postgres:5432/money_tracking_groups?sslmode=disable

REDIS_PASSWORD=change-me-redis

RABBITMQ_USERNAME=money_tracking
RABBITMQ_PASSWORD=change-me-rabbitmq

JWT_KEY_ID=money-tracking-auth-dev-key
JWT_PUBLIC_KEYS=money-tracking-auth-dev-key=/run/secrets/jwt-public.pem
JWT_REFRESH_TTL=168h

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Money Tracking <no-reply@local.test>
