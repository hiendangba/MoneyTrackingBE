static_resources:
  listeners:
    - name: http_listener
      address:
        socket_address:
          address: 0.0.0.0
          port_value: ${PORT}
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: ingress_http
                codec_type: AUTO
                normalize_path: true
                merge_slashes: true
                use_remote_address: true
                xff_num_trusted_hops: 1
                max_request_headers_kb: 32
                request_headers_timeout: 5s
                request_timeout: 15s
                stream_idle_timeout: 60s
                generate_request_id: true
                route_config:
                  name: local_route
                  virtual_hosts:
                    - name: auth_service
                      domains: ["*"]
                      typed_per_filter_config:
                        envoy.filters.http.cors:
                          "@type": type.googleapis.com/envoy.extensions.filters.http.cors.v3.CorsPolicy
                          allow_origin_string_match:
                            - safe_regex:
                                regex: '${CORS_ALLOWED_ORIGIN_REGEX}'
                          allow_methods: "GET,POST,PATCH,DELETE,OPTIONS"
                          allow_headers: "authorization,content-type,x-csrf-token"
                          expose_headers: "retry-after"
                          allow_credentials: true
                          max_age: "600"
                          forward_not_matching_preflights: false
                      response_headers_to_add:
                        - header:
                            key: strict-transport-security
                            value: "max-age=31536000; includeSubDomains"
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                        - header:
                            key: x-content-type-options
                            value: nosniff
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                        - header:
                            key: x-frame-options
                            value: DENY
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                        - header:
                            key: referrer-policy
                            value: no-referrer
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                        - header:
                            key: permissions-policy
                            value: "camera=(), microphone=(), geolocation=()"
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                        - header:
                            key: content-security-policy
                            value: "default-src 'none'; frame-ancestors 'none'"
                          append_action: OVERWRITE_IF_EXISTS_OR_ADD
                      routes:
                        - match: {path: /health}
                          route: {cluster: auth_service, timeout: 5s}
                          typed_per_filter_config:
                            envoy.filters.http.rbac:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        - match: {path: /.well-known/jwks.json}
                          route: {cluster: auth_service, timeout: 5s}
                          typed_per_filter_config:
                            envoy.filters.http.rbac:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        - match: {path: /api/auth/csrf}
                          route: {cluster: auth_service}
                          typed_per_filter_config:
                            envoy.filters.http.rbac:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        - match: {path: /api/auth/register}
                          route: {cluster: auth_service}
                          typed_per_filter_config:
                            envoy.filters.http.rbac:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        - match: {path: /api/auth/verify-otp}
                          route: {cluster: auth_service}
                          typed_per_filter_config:
                            envoy.filters.http.rbac:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        - match: {path: /api/auth/login}
                          route: {cluster: auth_service}
                          typed_per_filter_config:
                            envoy.filters.http.rbac:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        - match: {path: /api/auth/forgot-password}
                          route: {cluster: auth_service}
                          typed_per_filter_config:
                            envoy.filters.http.rbac:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        - match: {path: /api/auth/reset-password}
                          route: {cluster: auth_service}
                          typed_per_filter_config:
                            envoy.filters.http.rbac:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        - match: {path: /api/auth/refresh-token}
                          route: {cluster: auth_service}
                          typed_per_filter_config:
                            envoy.filters.http.rbac:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        - match: {path: /api/auth/logout}
                          route: {cluster: auth_service}
                          typed_per_filter_config:
                            envoy.filters.http.rbac:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        - match: {prefix: /api/auth/mobile/}
                          route: {cluster: auth_service}
                          typed_per_filter_config:
                            envoy.filters.http.rbac:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        - match:
                            prefix: "/"
                          route:
                            cluster: auth_service
                            timeout: 15s
                http_filters:
                  - name: envoy.filters.http.lua
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                      default_source_code:
                        inline_string: |
                          local function find_cookie(cookie_header, name)
                            if cookie_header == nil then
                              return nil
                            end
                            for pair in string.gmatch(cookie_header, "([^;]+)") do
                              local key, value = string.match(pair, "^%s*(.-)%s*=%s*(.-)%s*$")
                              if key == name and value ~= nil and value ~= "" then
                                return value
                              end
                            end
                            return nil
                          end

                          function envoy_on_request(request_handle)
                            local headers = request_handle:headers()
                            headers:remove("x-user-id")
                            headers:remove("x-user-role")
                            headers:remove("x-auth-sub")
                            headers:remove("x-auth-scope")
                            headers:remove("x-auth-token-type")
                            headers:remove("x-auth-sid")
                            headers:remove("x-auth-source")

                            local authorization = headers:get("authorization")
                            if authorization ~= nil and string.match(authorization, "^Bearer%s+[^%s]+$") then
                              headers:add("x-auth-source", "bearer")
                              return
                            end

                            local access_token = find_cookie(headers:get("cookie"), "access_token")
                            if access_token ~= nil then
                              headers:replace("authorization", "Bearer " .. access_token)
                              headers:add("x-auth-source", "cookie")
                            else
                              headers:remove("authorization")
                            end
                          end
                  - name: envoy.filters.http.jwt_authn
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
                      bypass_cors_preflight: true
                      strip_failure_response: true
                      providers:
                        money_tracking_access:
                          issuer: auth-service
                          audiences: [money-tracking-api]
                          require_expiration: true
                          max_lifetime: 330s
                          clock_skew_seconds: 30
                          forward: true
                          from_headers:
                            - name: Authorization
                              value_prefix: "Bearer "
                          payload_in_metadata: jwt_payload
                          jwt_cache_config:
                            jwt_cache_size: 1000
                          claim_to_headers:
                            - claim_name: sub
                              header_name: x-user-id
                            - claim_name: sub
                              header_name: x-auth-sub
                            - claim_name: token_type
                              header_name: x-auth-token-type
                            - claim_name: role_code
                              header_name: x-user-role
                            - claim_name: sid
                              header_name: x-auth-sid
                          remote_jwks:
                            cache_duration: 300s
                            http_uri:
                              uri: http://${AUTH_SERVICE_HOST}:${AUTH_SERVICE_PORT}/.well-known/jwks.json
                              cluster: auth_service
                              timeout: 5s
                      rules:
                        - match: {path: /health}
                        - match: {path: /.well-known/jwks.json}
                        - match: {path: /api/auth/csrf}
                        - match: {path: /api/auth/register}
                        - match: {path: /api/auth/verify-otp}
                        - match: {path: /api/auth/login}
                        - match: {path: /api/auth/forgot-password}
                        - match: {path: /api/auth/reset-password}
                        - match: {path: /api/auth/refresh-token}
                        - match: {path: /api/auth/logout}
                        - match: {prefix: /api/auth/mobile/}
                        - match:
                            prefix: "/"
                          requires:
                            provider_and_audiences:
                              provider_name: money_tracking_access
                              audiences:
                                - money-tracking-api
                  - name: envoy.filters.http.rbac
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                      rules:
                        action: ALLOW
                        policies:
                          cors-preflight:
                            permissions:
                              - header:
                                  name: ":method"
                                  string_match:
                                    exact: OPTIONS
                            principals:
                              - any: true
                          access-token-only:
                            permissions:
                              - any: true
                            principals:
                              - header:
                                  name: x-auth-token-type
                                  string_match:
                                    exact: access
                  - name: envoy.filters.http.buffer
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.buffer.v3.Buffer
                      max_request_bytes: 65536
                  - name: envoy.filters.http.cors
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.cors.v3.Cors
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  clusters:
    - name: auth_service
      connect_timeout: 5s
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: auth_service
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: ${AUTH_SERVICE_HOST}
                      port_value: ${AUTH_SERVICE_PORT}

overload_manager:
  resource_monitors:
    - name: envoy.resource_monitors.global_downstream_max_connections
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.resource_monitors.downstream_connections.v3.DownstreamConnectionsConfig
        max_active_downstream_connections: 10000

admin:
  address:
    socket_address:
      address: 127.0.0.1
      port_value: 9901
